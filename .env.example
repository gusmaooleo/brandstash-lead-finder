# ─────────────────────────────────────────────────────────────────────────
# Three variables. That is the whole file.
#
# Everything else — Google Places key, Anthropic key + model, Resend/SMTP
# transport, sender identity, offer profile, rate & retention knobs, landing
# database — is configured in the app (Settings) and stored ENCRYPTED in
# MongoDB. See server/settings/.
# ─────────────────────────────────────────────────────────────────────────

# Port the API + built UI listen on.
APP_PORT=4000

# Where the lead finder's own MongoDB lives. This one cannot move into the
# database: it is how the database is found. Local default is host 27018 —
# docker-compose maps it there so it never collides with the Brandstash dev
# mongo on 27017, and inside compose the app container overrides this to
# mongodb://mongo:27017/…
MONGODB_URI=

# Unlocks every credential stored in the settings document (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# Never commit it. Losing it costs no lead data — the credentials simply have
# to be entered again in Settings.
APP_ENCRYPTION_KEY=
